# Ambiente virtual (uv.lock é versionado de propósito — é ele que torna o
# ambiente reproduzível)
.venv/

# Cache de testes
.pytest_cache/

# Arquivos do sistema (Windows/macOS/Linux)
.DS_Store
Thumbs.db
*:Zone.Identifier

# Configurações do VSCode
.vscode/

# Arquivos compilados do Python
__pycache__/
*.py[cod]

# Logs e arquivos temporários
*.log
logs/
debug.log
*.temp

# Arquivos de banco de dados locais
*.sqlite3
db.sqlite3

# Arquivos gerados automaticamente
*.bak
*.swp
*.swo

# Dependências do Node.js (caso use Dash ou frontend adicional)
node_modules/

# Dado bruto e tratado nunca vai para o Git. O único dado versionado é o
# resultado servido ao dashboard (dashboard/data/).
data/
checkpoints/

# `data/` casa com qualquer diretório com esse nome em qualquer nível, e isso
# inclui o do dashboard. O resultados.csv sobrevive só porque já era rastreado:
# qualquer arquivo novo publicado ali seria ignorado em silêncio, que é
# exatamente o tipo de falha que este projeto existe para não ter.
!dashboard/data/
!dashboard/data/**

# Variáveis de ambiente
*.env